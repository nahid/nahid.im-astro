---
// Paginated diary archive: /diaries/ , /diaries/page/2/ … (§2, 10 per page).
import type { GetStaticPaths, PaginateFunction } from 'astro';
import Base from '../../layouts/Base.astro';
import Folio from '../../components/Folio.astro';
import Masthead from '../../components/Masthead.astro';
import Nav from '../../components/Nav.astro';
import SectionHead from '../../components/SectionHead.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorialSeries from '../../components/EditorialSeries.astro';
import { PER_PAGE, SITE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';
import { t } from '../../utils/strings';

export const getStaticPaths = (async ({ paginate }: { paginate: PaginateFunction }) => {
	const posts = await getPublishedPosts();
	return paginate(posts, { pageSize: PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Page ≥2 gets its own title/description so paginated pages aren't duplicate content.
const pageSuffix = page.currentPage > 1 ? ` — Page ${page.currentPage}` : '';
const archiveTitle = `${t('allDiaries', 'en')}${pageSuffix}`;
const archiveDesc = `${t('diariesDesc', 'en')}${pageSuffix}`;
const breadcrumbs = [
	{ name: 'Home', url: '/' },
	{ name: 'Diaries', url: '/diaries/' },
	...(page.currentPage > 1
		? [{ name: `Page ${page.currentPage}`, url: page.url.current }]
		: []),
];
const showSeries = page.currentPage === 1;
---

<Base
	title={archiveTitle}
	description={archiveDesc}
	lang="en"
	prevUrl={page.url.prev}
	nextUrl={page.url.next}
	breadcrumbs={breadcrumbs}
>
	<Folio />
	<Masthead />
	<Nav />

	<main id="main">
		<Breadcrumbs crumbs={breadcrumbs} />
		{
			showSeries && (
				<>
					<SectionHead label={t('editorialSeries', 'en')} lang="en" />
					<p class="archive__lede">{t('editorialLede', 'en')}</p>
					<p class="archive__brand meta">{SITE.tagline} — {SITE.brandHeadline}</p>
					<EditorialSeries />
				</>
			)
		}
		<SectionHead label={t('allDiaries', 'en')} lang="en" />
		<div class="archive">
			{page.data.map((post) => <PostCard post={post} />)}
		</div>
		<Pagination
			prevUrl={page.url.prev}
			nextUrl={page.url.next}
			current={page.currentPage}
			total={page.lastPage}
			lang="en"
		/>
	</main>

	<Footer />
</Base>

<style>
	.archive__lede {
		max-width: var(--measure);
		margin: 0 0 var(--sp-3);
		color: var(--faded);
	}
	.archive__brand {
		margin: 0 0 var(--sp-5);
	}
	.archive {
		display: grid;
		gap: 0;
	}
	.archive > :global(.card) {
		border-top: var(--rule-hair);
	}
	.archive > :global(.card:first-child) {
		border-top: none;
	}
</style>
