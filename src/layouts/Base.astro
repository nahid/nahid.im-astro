---
import '../styles/tokens.css';
import '../../public/fonts/fonts.css';
import '../styles/global.css';
import { SITE } from '../consts';
import {
	buildBreadcrumbs,
	buildFaqPage,
	buildOrganization,
	buildPerson,
	buildProfilePage,
	buildWebSite,
	type Crumb,
	type FaqItem,
} from '../utils/seo';

interface Props {
	title?: string;
	description?: string;
	/** Dominant language for <html lang> (§3): post pages pass the post lang. */
	lang?: 'bn' | 'en';
	/** Full OG image URL for this page, if any. Falls back to SITE.ogImage. */
	ogImage?: string;
	/** Alt text for the social card image. Falls back to the page title. */
	ogImageAlt?: string;
	/** Present on article pages — switches og:type to "article", emits article:*
	 *  tags and a BlogPosting JSON-LD node. Dates are ISO strings. */
	article?: {
		publishedTime: string;
		modifiedTime?: string;
		author?: string;
		section?: string;
		tags?: string[];
		wordCount?: number;
		/** Pre-built BlogPosting node from the Post layout (keeps Base lean). */
		jsonLd?: Record<string, unknown>;
	};
	/** FAQ pairs → FAQPage JSON-LD (and a visible section rendered by the page). */
	faq?: FaqItem[];
	/** Breadcrumb trail for BreadcrumbList + optional UI. */
	breadcrumbs?: Crumb[];
	/** ProfilePage graph on /about for author entity clarity (AEO/GEO). */
	profile?: boolean;
	/** Paginated archives thread these so crawlers get rel=prev/next. */
	prevUrl?: string;
	nextUrl?: string;
	/** Keep this page out of the index (404, dev-only pages). */
	noindex?: boolean;
}

const {
	title,
	description = SITE.description,
	lang = 'bn',
	ogImage,
	ogImageAlt,
	article,
	faq = [],
	breadcrumbs = [],
	profile = false,
	prevUrl,
	nextUrl,
	noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.masthead}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogLocale = lang === 'bn' ? 'bn_BD' : 'en_US';
const altLocale = lang === 'bn' ? 'en_US' : 'bn_BD';
const ogType = article ? 'article' : profile ? 'profile' : 'website';
const ogImageUrl = new URL(ogImage ?? SITE.ogImage, Astro.site).href;
const imageAlt = ogImageAlt ?? pageTitle;
const aboutUrl = new URL('/about/', Astro.site).href;
const prevHref = prevUrl ? new URL(prevUrl, Astro.site).href : undefined;
const nextHref = nextUrl ? new URL(nextUrl, Astro.site).href : undefined;
const robots = noindex
	? 'noindex, nofollow'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Structured data. Person + Organization + WebSite ride every page; posts add
// BlogPosting (+ FAQPage); About adds ProfilePage. Inert JSON-LD only (§ zero-JS).
const jsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@graph': [
		buildPerson(Astro.site),
		buildOrganization(Astro.site),
		buildWebSite(Astro.site),
		...(breadcrumbs.length ? [buildBreadcrumbs(breadcrumbs, Astro.site)] : []),
		...(profile
			? [buildProfilePage({ site: Astro.site, canonical, description })]
			: []),
		...(article?.jsonLd ? [article.jsonLd] : []),
		...(faq.length ? [buildFaqPage(faq, canonical)] : []),
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f2ece0" />
		<!-- Portrait favicons, generated locally by scripts/make-favicons.mjs. -->
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
		<link rel="author" href={aboutUrl} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={robots} />
		<link rel="canonical" href={canonical} />
		{prevHref && <link rel="prev" href={prevHref} />}
		{nextHref && <link rel="next" href={nextHref} />}

		<!-- Critical display and body fonts preloaded for fast FCP without render delays. -->
		<link
			rel="preload"
			href="/fonts/special-elite-01.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		{
			lang === 'bn' ? (
				<link
					rel="preload"
					href="/fonts/noto-serif-bengali-00.woff2"
					as="font"
					type="font/woff2"
					crossorigin
				/>
			) : (
				<link
					rel="preload"
					href="/fonts/cutive-mono-01.woff2"
					as="font"
					type="font/woff2"
					crossorigin
				/>
			)
		}

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={altLocale} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		{
			/* Dimensions are only known for the generated default card
			   (scripts/make-og.mjs); hero images vary, so we stay quiet for those. */
			!ogImage && (
				<>
					<meta property="og:image:type" content="image/webp" />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
				</>
			)
		}
		{
			article && (
				<>
					<meta property="article:published_time" content={article.publishedTime} />
					<meta
						property="article:modified_time"
						content={article.modifiedTime ?? article.publishedTime}
					/>
					<meta property="article:author" content={article.author ?? SITE.author} />
					{article.section && <meta property="article:section" content={article.section} />}
					{article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
				</>
			)
		}

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={SITE.twitterHandle} />
		<meta name="twitter:creator" content={SITE.twitterHandle} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="sheet">
			<slot />
		</div>
	</body>
</html>
