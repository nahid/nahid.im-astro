---
// Single-post article layout. Phase 1 delivers the structure; Phase 3 refines
// the Bengali typography (drop-cap equivalent, prev/next copy, dates).
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Folio from '../components/Folio.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import Faq from '../components/Faq.astro';
import AuthorCard from '../components/AuthorCard.astro';
import { categoryLabel } from '../utils/categories';
import { formatDate, formatNumber, readingMinutes } from '../utils/format';
import { t } from '../utils/strings';
import { SITE } from '../consts';
import { buildBlogPosting } from '../utils/seo';

interface Props {
	post: CollectionEntry<'diaries'>;
	prev?: { slug: string; title: string } | null;
	next?: { slug: string; title: string } | null;
}

const { post, prev, next } = Astro.props;
const { data } = post;
const lang = data.lang;
const minutes = readingMinutes(post.body ?? '', lang);
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const canonicalPath = `/diaries/${post.id}/`;
const ogImage = data.heroImage ? new URL(data.heroImage, Astro.site).href : undefined;
const ogImageUrl = new URL(data.heroImage ?? SITE.ogImage, Astro.site).href;
const categoryHref = `/diaries/category/${data.category}/`;
const categoryName = categoryLabel(data.category, 'en');
const faq = data.faq ?? [];
const takeaways = data.keyTakeaways ?? [];

const breadcrumbs = [
	{ name: 'Home', url: '/' },
	{ name: 'Diaries', url: '/diaries/' },
	{ name: categoryName, url: categoryHref },
	{ name: data.title, url: canonicalPath },
];

const articleJsonLd = buildBlogPosting({
	site: Astro.site,
	title: data.title,
	description: data.description,
	canonical: new URL(canonicalPath, Astro.site).href,
	inLanguage: lang === 'bn' ? 'bn-BD' : 'en-US',
	publishedTime: data.pubDate.toISOString(),
	modifiedTime: data.updatedDate?.toISOString(),
	imageUrl: ogImageUrl,
	imageAlt: data.heroImageAlt ?? data.title,
	category: categoryName,
	tags: data.tags,
	wordCount,
});

const article = {
	publishedTime: data.pubDate.toISOString(),
	modifiedTime: data.updatedDate?.toISOString() ?? data.pubDate.toISOString(),
	author: SITE.author,
	section: categoryName,
	tags: data.tags,
	wordCount,
	jsonLd: articleJsonLd,
};
---

<Base
	title={data.title}
	description={data.description}
	lang={lang}
	ogImage={ogImage}
	ogImageAlt={data.heroImageAlt ?? data.title}
	article={article}
	faq={faq}
	breadcrumbs={breadcrumbs}
>
	<Folio />
	<Masthead />
	<Nav />

	<main id="main">
		<article class="post" lang={lang} itemscope itemtype="https://schema.org/BlogPosting">
			<Breadcrumbs crumbs={breadcrumbs} />
			<a class="post__eyebrow label" href={categoryHref}>
				{categoryName}
			</a>
			<h1 class="post__headline" itemprop="headline">{data.title}</h1>

			<div class="post__byline">
				<span>
					{t('byline', 'en')}
					<meta itemprop="author" content={SITE.author} />
				</span>
				<span aria-hidden="true"> · </span>
				<time
					datetime={data.pubDate.toISOString().slice(0, 10)}
					itemprop="datePublished"
				>
					{formatDate(data.pubDate, 'en')}
				</time>
				<span aria-hidden="true"> · </span>
				<span>{formatNumber(minutes, 'en')} {t('minRead', 'en')}</span>
			</div>

			{
				data.heroImage && (
					<figure>
						<img
							src={data.heroImage}
							alt={data.heroImageAlt ?? data.title}
							width="800"
							height="450"
							loading="eager"
							fetchpriority="high"
							decoding="async"
							itemprop="image"
						/>
						{data.heroImageAlt && <figcaption>{data.heroImageAlt}</figcaption>}
					</figure>
				)
			}

			<KeyTakeaways items={takeaways} lang={lang} />

			<div class={`prose prose--${lang}`} itemprop="articleBody">
				<slot />
			</div>

			<Faq items={faq} lang={lang} />
			<AuthorCard lang={lang} />
		</article>
	</main>

	{
		(prev || next) && (
			<nav class="post-nav" aria-label="More dispatches">
				<span class="post-nav__end">
					{prev && (
						<a href={`/diaries/${prev.slug}/`}>
							<span class="label">{t('prevPost', 'en')}</span>
							<span class="post-nav__title">{prev.title}</span>
						</a>
					)}
				</span>
				<span class="post-nav__end post-nav__end--right">
					{next && (
						<a href={`/diaries/${next.slug}/`}>
							<span class="label">{t('nextPost', 'en')}</span>
							<span class="post-nav__title">{next.title}</span>
						</a>
					)}
				</span>
			</nav>
		)
	}

	<Footer />
</Base>

<style>
	.post {
		max-width: 50rem;
		margin-inline: auto;
		margin-top: var(--sp-4);
	}
	.post__eyebrow {
		/* inline-block, or the vertical margin below is dropped and the chip's
		   background bleeds into the headline's line box. */
		display: inline-block;
		margin: var(--sp-3) 0 var(--sp-2);
		color: var(--paper);
		background: var(--faded);
		padding: 0.56em 0.55em 0.16em;
		line-height: 1;
		text-indent: var(--letterspace-label);
		text-decoration: none;
	}
	.post__eyebrow:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.post__headline {
		font-size: var(--fs-h1);
		margin: 0 0 var(--sp-3);
	}
	.post__byline {
		font-size: var(--fs-meta);
		color: var(--faded);
		padding-bottom: var(--sp-3);
		border-bottom: 3px double var(--rule);
		margin-bottom: var(--sp-5);
	}

	.prose {
		font-size: 1.1em;
		text-align: justify;
	}
	/* Code blocks: a fixed rem size, so the block reads the same in a Bengali post
	   as in an English one, plus a line-height tight enough to resist the Bengali
	   leading. 1.5 is the floor that still clears descenders.
	   0.85rem, not 0.9: JetBrains Mono's x-height runs taller than the body face. */
	.prose :global(pre),
	.prose :global(pre code) {
		font-size: 0.85rem;
		line-height: 1.5;
	}
	/* Latin body: Cutive Mono, drop cap on the first paragraph. */
	.prose--en :global(> p:first-of-type::first-letter) {
		float: left;
		font-family: var(--font-display);
		font-size: 3.4em;
		line-height: 0.8;
		padding: 0.05em 0.1em 0 0;
		color: var(--accent);
	}
	/* Bengali: no Latin drop cap; an oxblood first-line treatment instead (§3). */
	.prose--bn :global(> p:first-of-type::first-line) {
		color: var(--accent);
		font-weight: 700;
	}
	.prose--bn {
		/* Bengali hyphenation is poor — never break mid-conjunct. */
		hyphens: none;
		word-break: normal;
		/* And because it cannot hyphenate, justifying it can only pay for the
		   ragged edge with word-space — which opens rivers through the column.
		   Bengali sets ragged-right; the Latin columns keep the justified
		   newspaper measure. */
		text-align: start;
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--sp-4);
		max-width: 42rem;
		margin: var(--sp-7) auto 0;
		padding-top: var(--sp-4);
		border-top: var(--rule-thin);
	}
	.post-nav__end a {
		text-decoration: none;
		display: block;
	}
	.post-nav__end--right {
		text-align: right;
	}
	.post-nav__title {
		display: block;
		margin-top: var(--sp-1);
	}
	.post-nav__end a:hover .post-nav__title {
		color: var(--accent);
	}
	/* Small screens: two title columns get too narrow — stack them. */
	@media (max-width: 34rem) {
		.post-nav {
			grid-template-columns: 1fr;
			gap: var(--sp-4);
		}
		.post-nav__end--right {
			text-align: left;
		}
	}
</style>
